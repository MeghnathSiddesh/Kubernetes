#to limit resources in a namespace, create a resource quota to create one

#use definition file for ResourceQuota

apiVersion: v1
kind: ResourceQuota
metadata:
  name: compute-resource
  namespace: dev #namespace which you want to limit the resources

spec:
#under spec section define the the limts of the namespace
  hard:
    pods: "10"
    requests.cpu: "4"
    requests.memory: 5Gi
    limits.cpu: "10"
    limits.memory: 10Gi

#create the ResourceQuota for the namespace
kubectl create -f definition.yaml