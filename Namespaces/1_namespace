#this command only lists the pods in default namespace
kubectl get pods

#to list pods in non default namsepace
kubectl get pods --namespace=namespace_name

kubectl get pods --namespace=kube-system

#when you create a pod, it is created in default namespace

#to create a pod in no default namespace use

kubectl create -f definition.yaml --namespace=dev

#or else you can define the namespace inside the definition file iteslf

#ex: to create a pod in particular namespace, use the namsepace option under metadata section in definition file

apiVersion: 
kind: 
metadata: 
  namespace: dev
  name: my-app
  labels: 
    app: myapp
    type: frontend
spec: 
  containers: 
    - name: nginx
      image: nginx

kubectl create -f definition.yaml

------

creating namespace

#like other objects, use namespace definition file

apiVersion: v1
kind: namespace
metadata:
  name: dev #name of namespace

#run
kubectl create -f definition.yaml

#another way to create namespace 
kubectl create namespace dev

------------

#by default you will be inside default namespace, to use or access resource inside other namespace you have to use --namespace=dev option

#if you want to switch to other namespace, rather than everytime giving --namespace option

kubectl config set-context $(kubectl config current-context) --namespace=dev

#$(kubectl config current-context) -> identify the current context
#and then locks the current context to dev namespace

#contexts are used to manage multiple clusters and multiple environments from the same management system

#now you can directly configure dev namespace resources
#if you want to configure other namespace resource like prod, use --namespace=prod

#to view pods in all namespaces
kubectl get pods --all-namespaces

